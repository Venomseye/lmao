font=JetBrainsMono Nerd Font 11
width=320
height=110
margin=10
padding=10
border-size=2
border-radius=8

default-timeout=5000
ignore-timeout=1
layer=overlay
anchor=top-right

# Colors are generated by matugen from your current wallpaper.
# Do not hardcode colors below this line - see
# ~/.config/matugen/templates/mako-colors.template
# This must come before any [urgency=...] sections below, otherwise
# its top-level color lines would get scoped into the last open section.
include=~/.config/mako/mako-colors

[urgency=high]
default-timeout=0
